#!/bin/bash
#
# offsite-backup: encrypted, tamper-resistant backup to Google Cloud Storage.
# Installed by the ledurnan.gcs_backup.offsite_backup role; edit the role,
# not this copy.
#
# One run:
#   1. check each tier's bucket keeps and expires objects for the days
#      this host expects (the tier contract); refuse to upload if not
#   2. run the optional pre-backup hook (a database dump, an export) into
#      a scratch directory
#   3. tar the configured paths plus that dump, encrypt to the age
#      recipients (the host holds no private key)
#   4. refuse an archive that is larger than the configured ceiling, or
#      that grew too much since the last good run (the size guard)
#   5. upload to the bucket of each tier due today, then read each object
#      back and compare sizes. A tier whose object for this period was
#      already stored today keeps it. Retention is the bucket's: the host
#      never chooses how long anything is kept (ADR 0007)
#
# Usage: offsite-backup [--check-contract]
#   --check-contract  only run step 1, then exit
#
# Configuration, all under $OFFSITE_BACKUP_CONF_DIR (default /etc/offsite-backup):
#   backup.conf   shell KEY=value lines: BUCKET_PREFIX, PREFIX,
#                 LIFECYCLE_SLACK_DAYS, WORK_DIR, STATE_DIR, MAX_SIZE,
#                 MAX_GROWTH_PERCENT, GROWTH_MIN_SIZE
#                 (sizes in bytes, or with a K, M, G or T suffix: powers
#                 of 1024)
#   tiers         one tier per line: <name> <retain_days> <when> [<name_format>]
#                   each tier's bucket is <BUCKET_PREFIX>-<name>
#                   when: always | weekday:<1-7, Monday=1> | monthday:<01-28>
#                   name_format: date(1) format for the object name
#   paths         one absolute path per line
#   recipients    age recipients, one per line (age -R format)
#   pre-backup    optional executable, run with DUMP_DIR set; whatever it
#                 writes there is archived under offsite-backup-dump/
#
# State, under $STATE_DIR:
#   last-size     the archive size of the last successful run, which the
#                 growth check compares against
#   accept-size   if present, the next run skips the growth check once
#                 (never the ceiling) and removes it on success
#   last-error    why the last run failed, for offsite-backup-report

set -euo pipefail
umask 077

CONF_DIR="${OFFSITE_BACKUP_CONF_DIR:-/etc/offsite-backup}"
# Tests set OFFSITE_BACKUP_NOW (seconds since the epoch) to pin the date.
NOW="${OFFSITE_BACKUP_NOW:-$(date -u +%s)}"

# shellcheck source=/dev/null
. "$CONF_DIR/backup.conf"

: "${BUCKET_PREFIX:?BUCKET_PREFIX is not set in backup.conf}"
: "${PREFIX:?PREFIX is not set in backup.conf}"
: "${LIFECYCLE_SLACK_DAYS:?LIFECYCLE_SLACK_DAYS is not set in backup.conf}"
: "${WORK_DIR:?WORK_DIR is not set in backup.conf}"
: "${STATE_DIR:?STATE_DIR is not set in backup.conf}"
: "${MAX_SIZE:?MAX_SIZE is not set in backup.conf}"
: "${MAX_GROWTH_PERCENT:?MAX_GROWTH_PERCENT is not set in backup.conf}"
: "${GROWTH_MIN_SIZE:?GROWTH_MIN_SIZE is not set in backup.conf}"

export CLOUDSDK_CONFIG="${CLOUDSDK_CONFIG:-$STATE_DIR/gcloud}"
LAST_ERROR="$STATE_DIR/last-error"

log() {
  logger -t offsite-backup -p "daemon.$1" -- "$2" 2>/dev/null || true
  echo "$2" >&2
}

# The message is also left in LAST_ERROR for offsite-backup-report, the
# ExecStopPost= hook that reports each run.
die() {
  log err "$1"
  printf '%s\n' "$1" >"$LAST_ERROR"
  exit 1
}

mkdir -p "$STATE_DIR"
rm -f "$LAST_ERROR"

# Sizes accept a K, M, G or T suffix (powers of 1024).
to_bytes() {
  [[ "$2" =~ ^[0-9]+[KMGT]?$ ]] || die "$1 '$2' must be a whole number of bytes, optionally with K, M, G or T"
  numfmt --from=iec "$2"
}
MAX_BYTES="$(to_bytes MAX_SIZE "$MAX_SIZE")"
GROWTH_MIN_BYTES="$(to_bytes GROWTH_MIN_SIZE "$GROWTH_MIN_SIZE")"
[[ "$MAX_GROWTH_PERCENT" =~ ^[0-9]+$ ]] \
  || die "MAX_GROWTH_PERCENT '$MAX_GROWTH_PERCENT' must be a whole number (0 turns the growth check off)"
[ "$MAX_BYTES" -gt 0 ] || die "MAX_SIZE must be more than 0"

# --- tiers ------------------------------------------------------------

TIER_NAMES=()
TIER_DAYS=()
TIER_WHEN=()
TIER_FORMAT=()

while read -r name days when format; do
  [[ -z "${name:-}" || "$name" == \#* ]] && continue
  [[ "$days" =~ ^[1-9][0-9]*$ ]] || die "tier '$name': retain_days '$days' is not a whole number of at least 1"
  case "$when" in
    always) default_format='%Y-%m-%d' ;;
    weekday:[1-7]) default_format='%G-W%V' ;;
    monthday:0[1-9] | monthday:1[0-9] | monthday:2[0-8]) default_format='%Y-%m' ;;
    *) die "tier '$name': when '$when' must be always, weekday:<1-7> or monthday:<01-28>" ;;
  esac
  TIER_NAMES+=("$name")
  TIER_DAYS+=("$days")
  TIER_WHEN+=("$when")
  TIER_FORMAT+=("${format:-$default_format}")
done <"$CONF_DIR/tiers"

[ "${#TIER_NAMES[@]}" -gt 0 ] || die "no tiers configured in $CONF_DIR/tiers"

# --- 1. the tier contract ---------------------------------------------

# Each tier's bucket must keep objects for exactly retain_days (its
# retention policy) and delete them retain_days + slack after upload (an
# expiry rule covering every object). If they disagree with this host,
# objects would expire before anyone expects, or be kept longer than the
# consumer promised. Refuse to write anything until every tier agrees.
bucket_for() { printf '%s-%s' "$BUCKET_PREFIX" "$1"; }

check_contract() {
  local i bucket bucket_json problems="" locked=()
  for i in "${!TIER_NAMES[@]}"; do
    bucket="$(bucket_for "${TIER_NAMES[$i]}")"
    bucket_json="$(gcloud storage buckets describe "gs://${bucket}" --format=json)" \
      || die "cannot read gs://${bucket}'s configuration (does it exist, and does the role grant storage.buckets.get?)"

    python3 -c '
import json, sys

bucket = json.loads(sys.argv[1])
name, days, age = sys.argv[2], int(sys.argv[3]), int(sys.argv[4])
problems = []

policy = bucket.get("retention_policy") or bucket.get("retentionPolicy") or {}
period = policy.get("retentionPeriod", policy.get("retention_period"))
if period is None:
    problems.append(f"{name} has no retention policy")
elif int(period) != days * 86400:
    problems.append(f"{name} keeps objects {int(period) / 86400:g} days, this host expects {days}")

ages = []
for rule in (bucket.get("lifecycle_config") or bucket.get("lifecycle") or {}).get("rule", []):
    if rule.get("action", {}).get("type") != "Delete":
        continue
    cond = rule.get("condition", {})
    # Only a rule that matches every object counts: no prefix, suffix or
    # other filter, so nothing in the bucket escapes expiry.
    if set(cond) == {"age"}:
        ages.append(int(cond["age"]))
if not ages:
    problems.append(f"{name} has no expiry rule covering every object")
elif min(ages) != age:
    problems.append(f"{name} expires objects after {min(ages)} days, this host expects {age}")

if problems:
    print("; ".join(problems))
    sys.exit(1)
print("locked" if policy.get("isLocked", policy.get("is_locked")) in (True, "true", "True") else "unlocked")
' "$bucket_json" "$bucket" "${TIER_DAYS[$i]}" "$((TIER_DAYS[i] + LIFECYCLE_SLACK_DAYS))" \
      >"$STATE_DIR/contract" 2>&1 \
      || { problems+="${problems:+; }$(cat "$STATE_DIR/contract")"; continue; }
    locked+=("${TIER_NAMES[$i]}:$(cat "$STATE_DIR/contract")")
  done

  [ -z "$problems" ] || die "tier contract broken: $problems"
  log info "tier contract holds for ${BUCKET_PREFIX}-* (${locked[*]})"
}

check_contract

if [ "${1:-}" = "--check-contract" ]; then
  exit 0
fi

# --- 2 and 3. build -----------------------------------------------------

mkdir -p "$WORK_DIR"
WORK="$(mktemp -d "$WORK_DIR/run.XXXXXX")"
trap 'rm -rf "$WORK"' EXIT

TAR_ARGS=()

if [ -s "$CONF_DIR/paths" ]; then
  while read -r path; do
    [[ -z "$path" || "$path" == \#* ]] && continue
    [[ "$path" == /* ]] || die "path '$path' is not absolute"
    TAR_ARGS+=("${path#/}")
  done <"$CONF_DIR/paths"
fi

if [ -x "$CONF_DIR/pre-backup" ]; then
  mkdir -p "$WORK/offsite-backup-dump"
  log info "running pre-backup hook"
  DUMP_DIR="$WORK/offsite-backup-dump" "$CONF_DIR/pre-backup" \
    || die "pre-backup hook failed (rc=$?); nothing uploaded"
  TAR_ARGS+=(-C "$WORK" offsite-backup-dump)
fi

[ "${#TAR_ARGS[@]}" -gt 0 ] || die "nothing to back up: no paths and no pre-backup hook"

# tar exits 1 for "file changed as we read it", routine for live data and
# not a failure. Anything above 1 is. The archive streams straight into
# age, so only the encrypted copy ever touches disk.
#
# errexit is off for the pipeline so a failure reaches die() with its
# reason, instead of ending the script silently.
set +e +o pipefail
tar --warning=no-file-changed --warning=no-file-removed \
  -C / -cz "${TAR_ARGS[@]}" \
  | age -R "$CONF_DIR/recipients" -o "$WORK/backup.tar.age"
statuses=("${PIPESTATUS[@]}")
set -e -o pipefail

# age first: when age dies, tar fails with a broken pipe, and blaming tar
# would send you to the wrong place.
[ "${statuses[1]}" -eq 0 ] || die "age encryption failed with rc=${statuses[1]}; nothing uploaded"
[ "${statuses[0]}" -le 1 ] || die "tar failed with rc=${statuses[0]}; nothing uploaded"

LOCAL_SIZE="$(stat -c %s "$WORK/backup.tar.age")"
[ "$LOCAL_SIZE" -gt 0 ] || die "encrypted archive is empty; nothing uploaded"

# --- 4. size guard --------------------------------------------------------

# Every upload is stored once per due tier and, once Locked, can't be
# removed before it expires. So a path added by mistake, or data that
# ballooned, is cheapest to stop here, before anything is written.
#
# This guards against mistakes, not attackers: a compromised host can
# skip this script altogether.
human() { numfmt --to=iec-i --suffix=B "$1"; }

[ "$LOCAL_SIZE" -le "$MAX_BYTES" ] \
  || die "archive is $(human "$LOCAL_SIZE"), over MAX_SIZE $(human "$MAX_BYTES"); nothing uploaded. Check what is being backed up, or raise offsite_backup_max_size"

LAST_SIZE_FILE="$STATE_DIR/last-size"
ACCEPT_SIZE_FILE="$STATE_DIR/accept-size"
last_size="$(cat "$LAST_SIZE_FILE" 2>/dev/null || true)"

if [ -e "$ACCEPT_SIZE_FILE" ]; then
  log notice "accept-size is set: skipping the growth check for this run"
elif [ "$MAX_GROWTH_PERCENT" -gt 0 ] && [[ "$last_size" =~ ^[1-9][0-9]*$ ]] \
  && [ "$LOCAL_SIZE" -gt "$GROWTH_MIN_BYTES" ]; then
  limit=$((last_size + last_size * MAX_GROWTH_PERCENT / 100))
  [ "$LOCAL_SIZE" -le "$limit" ] \
    || die "archive is $(human "$LOCAL_SIZE"), up from $(human "$last_size") last run: more than MAX_GROWTH_PERCENT ${MAX_GROWTH_PERCENT}%; nothing uploaded. If the growth is expected, touch ${ACCEPT_SIZE_FILE} and run again"
fi

# --- 5. upload ------------------------------------------------------------

# Each tier is attempted even when another fails, so a retry after a
# part-failed run still writes the tiers that were missed. Failures are
# collected and fail the run at the end.
FAILURES=()
fail_tier() {
  log err "$1"
  FAILURES+=("$1")
}

# The first ERROR line gcloud printed, or its last line, kept short: it
# goes into the run report.
gcloud_reason() {
  local reason
  reason="$(grep -m 1 '^ERROR:' <<<"$1" || tail -n 1 <<<"$1")"
  reason="${reason#ERROR: }"
  printf '%s' "${reason:0:300}"
}

# A retained object can't be overwritten, and the writer can't delete, so
# an upload to a name that's taken fails. GCS reports that as a missing
# storage.objects.delete permission, which is true but invites the one
# fix that must never be made. So when an upload fails, look at the object:
#   - created on this run's day (UTC): an earlier run today, or a manual
#     run, already stored this tier's copy for the period. Keep it.
#   - created before this run's day: nothing that ran today wrote it. The
#     name was taken in advance, by a name_format that repeats across due
#     days, or by someone holding a writer key. Fail loudly.
#   - absent: a real upload failure. Report gcloud's reason.
RUN_DAY_START="$(date -u -d "$(date -u -d "@$NOW" +%F)" +%s)"
stored=0
kept=0

upload() {
  local url="$1" out remote_size created

  if ! out="$(gcloud storage cp "$WORK/backup.tar.age" "$url" 2>&1)"; then
    printf '%s\n' "$out" >&2
    if created="$(gcloud storage objects describe "$url" \
      --format='value(creation_time.date("%s"))' 2>/dev/null)" \
      && created="${created%%.*}" && [[ "$created" =~ ^[0-9]+$ ]]; then
      if [ "$created" -ge "$RUN_DAY_START" ]; then
        log notice "${url} already stored today, at $(date -u -d "@$created" +%H:%M) UTC; kept, not overwritten"
        kept=$((kept + 1))
      else
        fail_tier "${url} already exists, created $(date -u -d "@$created" '+%Y-%m-%d %H:%M') UTC, before this run's day, so no run today wrote it. Nothing was overwritten. If this tier's name_format gives the same name on more than one due day, change it. Otherwise someone with a writer key may have taken the name: see docs/emergency.md. Never grant the writer delete"
      fi
      return
    fi
    fail_tier "upload of ${url} failed: $(gcloud_reason "$out")"
    return
  fi

  # Read back. An upload that returns 0 but stored nothing useful is the
  # silent failure this whole design exists to catch.
  remote_size="$(gcloud storage objects describe "$url" \
    --format='value(size)' 2>/dev/null || true)"
  if [ "$remote_size" != "$LOCAL_SIZE" ]; then
    fail_tier "verify failed for ${url}: local ${LOCAL_SIZE} bytes, remote '${remote_size}'"
    return
  fi

  log info "stored ${url} (${LOCAL_SIZE} bytes)"
  stored=$((stored + 1))
}

DAY_OF_WEEK="$(date -u -d "@$NOW" +%u)"
DAY_OF_MONTH="$(date -u -d "@$NOW" +%d)"
due_tiers=0

for i in "${!TIER_NAMES[@]}"; do
  case "${TIER_WHEN[$i]}" in
    always) due=1 ;;
    weekday:*) [ "$DAY_OF_WEEK" = "${TIER_WHEN[$i]#weekday:}" ] && due=1 || due=0 ;;
    monthday:*) [ "$DAY_OF_MONTH" = "${TIER_WHEN[$i]#monthday:}" ] && due=1 || due=0 ;;
  esac
  [ "$due" -eq 1 ] || continue

  stamp="$(date -u -d "@$NOW" +"${TIER_FORMAT[$i]}")"
  upload "gs://$(bucket_for "${TIER_NAMES[$i]}")/${PREFIX}/${stamp}.tar.age"
  due_tiers=$((due_tiers + 1))
done

if [ "${#FAILURES[@]}" -gt 0 ]; then
  summary="$(printf '%s; ' "${FAILURES[@]}")"
  die "${#FAILURES[@]} of ${due_tiers} due tier(s) failed (${stored} stored, ${kept} already stored today): ${summary%; }"
fi

# A tier list where nothing is due today is legitimate (say, weekly only),
# but it means this run protected nothing, so say so.
if [ "$due_tiers" -eq 0 ]; then
  log warning "no tier was due today; nothing uploaded"
else
  log info "backup complete: ${stored} object(s) stored, ${kept} already stored today"
fi

# The baseline for the next run's growth check, and the size the run
# report carries. Written only once the run has succeeded.
printf '%s\n' "$LOCAL_SIZE" >"$LAST_SIZE_FILE"
rm -f "$ACCEPT_SIZE_FILE"
