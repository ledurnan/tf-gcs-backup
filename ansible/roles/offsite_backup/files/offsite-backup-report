#!/bin/bash
#
# offsite-backup-report: ExecStopPost= hook for offsite-backup.service.
# Reports how the run ended to a heartbeat URL (any service that accepts
# a JSON POST: OneUptime, Healthchecks and the like). It runs after every
# run, whether the backup succeeded, failed, timed out or was killed,
# which the backup script itself can't promise. So a failure alerts, and
# a run that never happens alerts on silence at the receiving end.
#
# Body: {"status":"ok"} or {"status":"failed","detail":"..."}.
#
# Never fails the unit: many heartbeat services answer 200 even to a wrong
# URL, so the receiving end, not this exit code, proves a report arrived.

set -u

STATE_DIR="${OFFSITE_BACKUP_STATE_DIR:-/var/lib/offsite-backup}"
LAST_ERROR="$STATE_DIR/last-error"

[[ -n "${REPORT_URL:-}" ]] || exit 0

if [[ "${SERVICE_RESULT:-}" == success ]]; then
  set -- ok
else
  # die() in the backup script leaves its message here. A failure it
  # didn't anticipate (set -e, a timeout, a kill) leaves none, and the
  # journal has the rest.
  reason="$(cat "$LAST_ERROR" 2>/dev/null || true)"
  set -- failed "Off-site backup failed on $(hostname) (result ${SERVICE_RESULT:-unknown}, ${EXIT_CODE:-?} ${EXIT_STATUS:-?}). ${reason:-See journalctl -u offsite-backup.service.}"
fi

body="$(python3 -c 'import json, sys
b = {"status": sys.argv[1]}
if len(sys.argv) > 2:
    b["detail"] = sys.argv[2][:2000]
print(json.dumps(b, separators=(",", ":")))' "$@")" || exit 0

# The URL is a credential: it goes to curl on stdin, never as an
# argument, where any local user could read it from the process list
# (printf is a builtin).
url="${REPORT_URL//\\/\\\\}"
url="${url//\"/\\\"}"
printf 'url = "%s"\n' "$url" \
  | curl -fsS -m 10 -o /dev/null -X POST --config - \
    -H 'Content-Type: application/json' -d "${body}" \
  || echo "warning: could not send the run report" >&2
exit 0
