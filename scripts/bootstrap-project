#!/bin/bash
#
# bootstrap-project: one-off setup of a Google Cloud project for this
# pattern, run by a project owner as themselves. Creates, if missing:
#
#   - the APIs impersonation and the modules need
#   - a custom role for Terraform: manage buckets, custom roles and
#     service accounts, with no permission to delete any of them, touch
#     objects in backup buckets, or create keys. That stops an apply
#     doing any of those by accident. It is not a wall: the role can
#     change IAM, so whoever runs Terraform could grant themselves more.
#   - a Terraform service account holding that role
#   - a versioned state bucket in this project, which the service
#     account can read and write
#   - permission for the operator's account to impersonate the service
#     account (and nobody else's)
#
# Every gcloud call names --account explicitly, so a workstation with
# several Google accounts (personal and work) can't use the wrong one.
#
# Usage:
#   bootstrap-project --project <id> --account <operator email>
#                     --location <region> --state-bucket <name>
#                     [--service-account <name>] [--role-id <id>] [--apply]
#
# Without --apply it changes nothing: it reads what exists and prints
# what it would run. Re-running is safe: what already exists is kept, and
# the role's permissions and the state bucket's settings are brought back
# to the ones below.

set -euo pipefail

project="" account="" location="" state_bucket=""
sa_name="tf-gcs-backup" role_id="tfGcsBackupAdmin" apply=0

while [ $# -gt 0 ]; do
  case "$1" in
    --project) project="$2"; shift 2 ;;
    --account) account="$2"; shift 2 ;;
    --location) location="$2"; shift 2 ;;
    --state-bucket) state_bucket="$2"; shift 2 ;;
    --service-account) sa_name="$2"; shift 2 ;;
    --role-id) role_id="$2"; shift 2 ;;
    --apply) apply=1; shift ;;
    -h | --help) sed -n '2,29p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

for v in project account location state_bucket; do
  [ -n "${!v}" ] || { echo "--${v//_/-} is required" >&2; exit 2; }
done

sa_email="${sa_name}@${project}.iam.gserviceaccount.com"
g=(gcloud --account="$account" --quiet)

# Terraform's permissions. Deliberately no *.delete, no storage.objects.*
# (the state bucket is granted separately, on that bucket only) and no
# iam.serviceAccountKeys.* (keys are issued out of band, ADR 0002).
# storage.buckets.setIamPolicy and iam.roles.update are needed to manage
# the writer role and its binding, and they are why this list is a guard
# against accidents and not a limit on whoever holds the role.
permissions=(
  storage.buckets.create
  storage.buckets.get
  storage.buckets.list
  storage.buckets.update
  storage.buckets.getIamPolicy
  storage.buckets.setIamPolicy
  iam.roles.get
  iam.roles.list
  iam.roles.create
  iam.roles.update
  iam.serviceAccounts.get
  iam.serviceAccounts.list
  iam.serviceAccounts.create
  iam.serviceAccounts.update
  resourcemanager.projects.get
)

role_description="Manage backup buckets, custom roles and service accounts. Holds no delete, object or key permissions; it can change IAM."

step() {
  echo
  echo "# $1"
}

run() {
  printf '%q ' "$@"
  echo
  if [ "$apply" -eq 1 ]; then
    "$@"
  fi
}

exists() {
  "$@" >/dev/null 2>&1
}

# A service account created moments ago isn't visible everywhere at once:
# a binding that names it can fail with "does not exist" for a minute or
# so. Retry exactly that failure; anything else fails straight away.
# BOOTSTRAP_RETRY_SECONDS (default 10) and BOOTSTRAP_RETRIES (default 12)
# set the pace.
run_retry() {
  printf '%q ' "$@"
  echo
  [ "$apply" -eq 1 ] || return 0
  local out attempt tries="${BOOTSTRAP_RETRIES:-12}"
  for ((attempt = 1; attempt <= tries; attempt++)); do
    if out="$("$@" 2>&1)"; then
      echo "$out"
      return 0
    fi
    if ! grep -q "does not exist" <<<"$out" || [ "$attempt" -eq "$tries" ]; then
      echo "$out" >&2
      return 1
    fi
    echo "# the service account isn't visible yet; retrying ($attempt/$tries)"
    sleep "${BOOTSTRAP_RETRY_SECONDS:-10}"
  done
}

[ "$apply" -eq 1 ] || echo "# Dry run: nothing is changed. Re-run with --apply to execute."

step "APIs"
run "${g[@]}" services enable iam.googleapis.com iamcredentials.googleapis.com \
  cloudresourcemanager.googleapis.com storage.googleapis.com --project="$project"

step "Terraform's custom role ($role_id)"
if exists "${g[@]}" iam roles describe "$role_id" --project="$project"; then
  echo "# exists: updating its permissions to the list above"
  run "${g[@]}" iam roles update "$role_id" --project="$project" \
    --description="$role_description" \
    --permissions="$(IFS=,; echo "${permissions[*]}")"
else
  run "${g[@]}" iam roles create "$role_id" --project="$project" \
    --title="tf-gcs-backup Terraform (no delete)" \
    --description="$role_description" \
    --permissions="$(IFS=,; echo "${permissions[*]}")"
fi

step "Terraform's service account ($sa_email)"
if exists "${g[@]}" iam service-accounts describe "$sa_email" --project="$project"; then
  echo "# exists"
else
  run "${g[@]}" iam service-accounts create "$sa_name" --project="$project" \
    --display-name="tf-gcs-backup Terraform" \
    --description="Used by Terraform through impersonation only. Never give it a key."
fi

step "Grant the role to the service account on the project"
run_retry "${g[@]}" projects add-iam-policy-binding "$project" \
  --member="serviceAccount:$sa_email" \
  --role="projects/$project/roles/$role_id" --condition=None

step "State bucket (gs://$state_bucket)"
# Bucket names are global, so a bucket answering to this name may belong
# to someone else's project, and state must never go there. --project
# doesn't narrow the lookup: compare the bucket's own project number.
if bucket_project="$("${g[@]}" storage buckets describe "gs://$state_bucket" \
  --raw --format='value(projectNumber)' 2>/dev/null)"; then
  project_number="$("${g[@]}" projects describe "$project" --format='value(projectNumber)')"
  if [ -z "$bucket_project" ] || [ "$bucket_project" != "$project_number" ]; then
    echo "gs://$state_bucket exists in project number ${bucket_project:-(unknown)}, not in $project ($project_number)." >&2
    echo "Nothing more was changed. Choose another --state-bucket." >&2
    exit 1
  fi
  echo "# exists in $project. Who can use it now, besides the grant below:"
  "${g[@]}" storage buckets get-iam-policy "gs://$state_bucket" \
    --format='table[no-heading](bindings.role, bindings.members.list())' | sed 's/^/#   /'
else
  run "${g[@]}" storage buckets create "gs://$state_bucket" --project="$project" \
    --location="$location" --default-storage-class=STANDARD \
    --uniform-bucket-level-access --public-access-prevention
fi
# Old versions of the state file are the undo for a bad apply. The access
# settings are repeated here so a bucket that already existed gets them.
run "${g[@]}" storage buckets update "gs://$state_bucket" --project="$project" \
  --versioning --uniform-bucket-level-access --public-access-prevention

step "Let the service account read and write state, in the state bucket only"
run_retry "${g[@]}" storage buckets add-iam-policy-binding "gs://$state_bucket" \
  --project="$project" \
  --member="serviceAccount:$sa_email" --role=roles/storage.objectAdmin

step "Let $account impersonate the service account"
run_retry "${g[@]}" iam service-accounts add-iam-policy-binding "$sa_email" \
  --project="$project" \
  --member="user:$account" --role=roles/iam.serviceAccountTokenCreator

cat <<EOF

# Then, in the consuming configuration:
#
#   .tf-identity (committed; contains no secrets):
#     ACCOUNT=$account
#     SERVICE_ACCOUNT=$sa_email
#
#   backend "gcs" {
#     bucket = "$state_bucket"
#     prefix = "<consumer>/<name>"
#   }
#
# and run Terraform through scripts/tf-with-identity. New permissions
# can take a minute or two to apply to impersonation.
EOF
