#!/bin/bash
#
# restore-test: prove a backup can actually be restored.
#
# Fetches the most recently created backup for one host and tier, decrypts
# it with an operator's age identity, lists the archive, and checks that
# each expected entry is present. Nothing is extracted. Run it as an
# operator (the backed-up host holds no private key), by hand or on a
# schedule.
#
# Usage:
#   restore-test --bucket <bucket> --prefix <host prefix> --tier <tier>
#                --identity <age identity file>
#                [--expect <entry>]... [--max-age <hours>]
#                [--report-url-file <file>]
#
#   --expect           a path that must appear in the archive, matched as
#                      a substring of an entry (e.g. etc/letsencrypt/ or
#                      offsite-backup-dump/). Repeatable.
#   --max-age          fail if the newest backup was created more than
#                      this many hours ago (e.g. 26 for a daily tier), so
#                      backups that have stopped fail the test.
#   --report-url-file  optional file holding a heartbeat URL on its first
#                      line: POSTs {"status":"ok"} or
#                      {"status":"failed","detail":...}, like the host's
#                      report. The URL is a credential, so it is never
#                      taken as an argument, where other users of the
#                      machine could read it: keep the file readable by
#                      its owner only, or set RESTORE_TEST_REPORT_URL in
#                      the environment instead.
#
# Exit status: 0 if the newest backup decrypts, lists, holds every
# expected entry and is no older than --max-age; non-zero otherwise.

set -euo pipefail

bucket="" prefix="" tier="" identity="" max_age=""
report_url="${RESTORE_TEST_REPORT_URL:-}"
expect=()

while [ $# -gt 0 ]; do
  case "$1" in
    --bucket) bucket="$2"; shift 2 ;;
    --prefix) prefix="$2"; shift 2 ;;
    --tier) tier="$2"; shift 2 ;;
    --identity) identity="$2"; shift 2 ;;
    --expect) expect+=("$2"); shift 2 ;;
    --max-age) max_age="$2"; shift 2 ;;
    --report-url-file) report_url="$(head -n 1 -- "$2")"; shift 2 ;;
    --report-url)
      echo "--report-url is gone: an argument is readable by other users of this machine." >&2
      echo "Use --report-url-file <file> or RESTORE_TEST_REPORT_URL instead." >&2
      exit 2 ;;
    -h | --help) sed -n '2,33p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

for v in bucket prefix tier identity; do
  [ -n "${!v}" ] || { echo "--$v is required" >&2; exit 2; }
done
[[ -z "$max_age" || "$max_age" =~ ^[1-9][0-9]*$ ]] \
  || { echo "--max-age must be a whole number of hours" >&2; exit 2; }

report() {
  [ -n "$report_url" ] || return 0
  local body
  body="$(python3 -c 'import json, sys
b = {"status": sys.argv[1]}
if len(sys.argv) > 2:
    b["detail"] = sys.argv[2][:2000]
print(json.dumps(b, separators=(",", ":")))' "$@")"
  # On stdin, never as an argument (printf is a builtin).
  local url="${report_url//\\/\\\\}"
  url="${url//\"/\\\"}"
  printf 'url = "%s"\n' "$url" \
    | curl -fsS -m 10 -o /dev/null -X POST --config - \
      -H 'Content-Type: application/json' -d "$body" \
    || echo "warning: could not send the report" >&2
}

fail() {
  echo "FAIL: $1"
  report failed "Restore test failed for gs://${bucket}/${tier}/${prefix}/: $1"
  exit 1
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# The backed-up host can write any object name here, so a name doesn't
# say which backup is newest: the creation time does, and the server sets
# it. Each line is "<size>  <creation time, UTC>  <url>". Anything that
# isn't a backup object (<stamp>.tar.age) is never the one tested.
listing="$(gcloud storage ls -l "gs://${bucket}/${tier}/${prefix}/" 2>/dev/null || true)"
objects="$(awk '$1 ~ /^[0-9]+$/ && $3 ~ /^gs:\/\// && NF == 3 { print $2, $3 }' <<<"$listing")"
[ -n "$objects" ] || fail "no objects under gs://${bucket}/${tier}/${prefix}/"
backups="$(grep -E '\.tar\.age$' <<<"$objects" || true)"
strays="$(grep -cvE '\.tar\.age$' <<<"$objects" || true)"
[ "$strays" -eq 0 ] \
  || echo "warning: ignoring $strays object(s) under gs://${bucket}/${tier}/${prefix}/ that are not <stamp>.tar.age" >&2
[ -n "$backups" ] || fail "no backup objects (<stamp>.tar.age) under gs://${bucket}/${tier}/${prefix}/"
read -r created newest <<<"$(sort <<<"$backups" | tail -n 1)"
echo "newest: $newest (created $created)"

if [ -n "$max_age" ]; then
  created_s="$(date -u -d "$created" +%s 2>/dev/null)" \
    || fail "cannot read the creation time of $newest ($created)"
  age_h=$(((${RESTORE_TEST_NOW:-$(date +%s)} - created_s) / 3600))
  [ "$age_h" -lt "$max_age" ] \
    || fail "the newest backup, $newest, was created ${age_h}h ago (limit ${max_age}h)"
fi

gcloud storage cp "$newest" "$work/backup.tar.age" >/dev/null 2>&1 \
  || fail "could not download $newest"

age -d -i "$identity" -o "$work/backup.tar.gz" "$work/backup.tar.age" \
  || fail "could not decrypt $newest with $identity"

tar -tzf "$work/backup.tar.gz" >"$work/listing" 2>/dev/null \
  || fail "$newest decrypted but is not a readable archive"

entries="$(wc -l <"$work/listing")"
[ "$entries" -gt 0 ] || fail "$newest is an empty archive"
echo "entries: $entries"

missing=()
for e in ${expect[@]+"${expect[@]}"}; do
  grep -qF -- "$e" "$work/listing" || missing+=("$e")
done
[ "${#missing[@]}" -eq 0 ] || fail "missing from $newest: ${missing[*]}"

echo "PASS: $newest decrypts and holds ${entries} entries${expect[0]+, including every expected one}"
report ok
