#!/bin/bash
#
# restore-test: prove a backup can actually be restored.
#
# Fetches the newest object for one host and tier, decrypts it with an
# operator's age identity, lists the archive, and checks that each
# expected entry is present. Nothing is extracted. Run it as an operator
# (the backed-up host holds no private key), by hand or on a schedule.
#
# Usage:
#   restore-test --bucket <bucket> --prefix <host prefix> --tier <tier>
#                --identity <age identity file>
#                [--expect <entry>]... [--report-url <url>]
#
#   --expect      a path that must appear in the archive, matched as a
#                 substring of an entry (e.g. etc/letsencrypt/ or
#                 offsite-backup-dump/). Repeatable.
#   --report-url  optional heartbeat URL: POSTs {"status":"ok"} or
#                 {"status":"failed","detail":...}, like the host's report.
#
# Exit status: 0 if the newest object decrypts, lists, and holds every
# expected entry; non-zero otherwise.

set -euo pipefail

bucket="" prefix="" tier="" identity="" report_url=""
expect=()

while [ $# -gt 0 ]; do
  case "$1" in
    --bucket) bucket="$2"; shift 2 ;;
    --prefix) prefix="$2"; shift 2 ;;
    --tier) tier="$2"; shift 2 ;;
    --identity) identity="$2"; shift 2 ;;
    --expect) expect+=("$2"); shift 2 ;;
    --report-url) report_url="$2"; shift 2 ;;
    -h | --help) sed -n '2,24p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

for v in bucket prefix tier identity; do
  [ -n "${!v}" ] || { echo "--$v is required" >&2; exit 2; }
done

report() {
  [ -n "$report_url" ] || return 0
  local body
  body="$(python3 -c 'import json, sys
b = {"status": sys.argv[1]}
if len(sys.argv) > 2:
    b["detail"] = sys.argv[2][:2000]
print(json.dumps(b, separators=(",", ":")))' "$@")"
  curl -fsS -m 10 -o /dev/null -X POST "$report_url" \
    -H 'Content-Type: application/json' -d "$body" \
    || echo "warning: could not send the report" >&2
}

fail() {
  echo "FAIL: $1"
  report failed "Restore test failed for gs://${bucket}/${tier}/${prefix}/: $1"
  exit 1
}

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

# Object names sort chronologically within a tier (they're dated), so the
# last one listed is the newest.
newest="$(gcloud storage ls "gs://${bucket}/${tier}/${prefix}/" 2>/dev/null | sort | tail -n 1 || true)"
[ -n "$newest" ] || fail "no objects under gs://${bucket}/${tier}/${prefix}/"
echo "newest: $newest"

gcloud storage cp "$newest" "$work/backup.tar.age" >/dev/null 2>&1 \
  || fail "could not download $newest"

age -d -i "$identity" -o "$work/backup.tar.gz" "$work/backup.tar.age" \
  || fail "could not decrypt $newest with $identity"

tar -tzf "$work/backup.tar.gz" >"$work/listing" 2>/dev/null \
  || fail "$newest decrypted but is not a readable archive"

entries="$(wc -l <"$work/listing")"
[ "$entries" -gt 0 ] || fail "$newest is an empty archive"
echo "entries: $entries"

missing=()
for e in ${expect[@]+"${expect[@]}"}; do
  grep -qF -- "$e" "$work/listing" || missing+=("$e")
done
[ "${#missing[@]}" -eq 0 ] || fail "missing from $newest: ${missing[*]}"

echo "PASS: $newest decrypts and holds ${entries} entries${expect[0]+, including every expected one}"
report ok
